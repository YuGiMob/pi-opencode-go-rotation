{
  "name": "@yugimob/pi-opencode-go-rotation",
  "version": "1.7.0",
  "description": "Rotate between multiple OpenCode Go API keys with reactive 429, rate-limit, and watchdog stall detection, plus live footer usage for the active key",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuGiMob/pi-opencode-go-rotation.git"
  },
  "homepage": "https://github.com/YuGiMob/pi-opencode-go-rotation#readme",
  "bugs": {
    "url": "https://github.com/YuGiMob/pi-opencode-go-rotation/issues"
  },
  "author": "Yugimob (https://github.com/YuGiMob)",
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": ">=0.71.1",
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@mariozechner/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "keywords": [
    "pi-extension",
    "pi-package",
    "opencode",
    "api-key-rotation",
    "rate-limit",
    "usage"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "@mariozechner/pi-coding-agent": "0.71.1",
    "typescript": "5.9.3"
  }
}
